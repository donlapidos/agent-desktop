{
  "name": "desktop-buddy",
  "version": "0.1.0",
  "private": true,
  "description": "A Clicky-style desktop buddy: points at your screen to teach, and drives your apps when you ask. Built on agent-desktop.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "check": "tsc -p .",
    "measure:idle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-idle.ps1",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "docx": "^9.5.1",
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "typescript": "5.9.3"
  }
}
